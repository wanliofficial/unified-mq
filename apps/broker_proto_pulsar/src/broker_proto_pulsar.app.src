{application, broker_proto_pulsar, [
    {description, "Pulsar binary protocol adapter: produce/consume/ack/seek"},
    {vsn, "0.1.0"},
    {registered, [broker_proto_pulsar_sup, pulsar_subscriptions]},
    {mod, {broker_proto_pulsar_app, []}},
    {applications, [kernel, stdlib, sasl, ranch, broker_core, broker_metrics,
                    broker_storage, broker_router, broker_queue, broker_subscription,
                    broker_event, broker_security]},
    {env, [{%% No listener unless the release config supplies one; CT binds its
            %% own ephemeral port, exactly like the other protocol apps.
            listeners, []},
           {advertised_host, <<"127.0.0.1">>}]}
]}.
