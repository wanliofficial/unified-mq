{application, broker_proto_mqtt, [
    {description, "MQTT 3.1/3.1.1 adapter: frame codec, connection FSM, message construction"},
    {vsn, "0.1.0"},
    {registered, [broker_proto_mqtt_sup, mqtt_conn_sup]},
    {mod, {broker_proto_mqtt_app, []}},
    {applications, [kernel, stdlib, sasl, ranch, broker_core, broker_metrics,
                    broker_storage, broker_router, broker_queue, broker_subscription,
                    broker_event, broker_security, broker_retain]},
    {env, [{%% Empty on purpose: a library/test node binds no port unless the
            %% release config (config/sys.config.src) supplies a listener. T12's
            %% listener suite supplies its own ephemeral port.
            listeners, []},
           %% MQ-05 (ADR-017 §17.x): enhanced-auth framework. `mqtt_auth_methods'
           %% names the enabled broker_auth_<name> modules; a CONNECT naming a
           %% method not in this list is refused. `mqtt_auth_timeout_ms' is the
           %% challenge/response handshake deadline.
           {mqtt_auth_methods, [<<"plain">>]},
           {mqtt_auth_timeout_ms, 30000},
           %% MQ-07: advertise the four static capability bits on a v5 CONNACK.
           %% `maximum_qos' is deliberately omitted (§3.2.2.3.4 only allows 0/1;
           %% absent means QoS 2, which is what we support).
           {mqtt_connack_props_v5, true},
           %% MQ-06: prefix handed back as response_information when a v5 CONNECT
           %% sets request_response_information. undefined = feature off (no
           %% property emitted). Must be a UTF-8 binary string.
           {mqtt_response_information, undefined},
           %% MQ-04: inbound Topic Alias limit announced on a v5 CONNACK; 0 = off.
           {mqtt_topic_alias_maximum, 0},
           {pull_page_limit, 32},
           {max_inflight, 64},
           {pull_poll_interval_ms, 1000},
           {inflight_snapshot_ms, 20},
           {max_keepalive_ms, 60000},
           %% S2-C (ADR-018 §18.4): QoS 2 is allowed by default and bounded by
           %% the backend capability at CONNECT (E2). `released' + `received'
           %% per session are capped; over the cap is a deliberate disconnect.
           {mqtt_max_qos, 2},
           {max_qos2_state_per_session, 100},
           %% S2-E (ADR-015 §15.1/§15.4): the ack-timeout failure signal and the
           %% default publish-time TTL (0 = no expiry).
           {ack_timeout_ms, 30000},
           {message_ttl_ms, 0},
           %% S2.5 (ADR-017 §17.3): the inbound packet cap. `0' disables the
           %% check (S1/S2 default); a non-zero value closes the connection on
           %% the first frame larger than it, without acking.
           {mqtt_max_packet_size, 0},
           %% S2-G (design §4.7): the consumer/producer mailbox watermarks. `0'
           %% disables the check; `max_inflight' remains the delivery window.
           {pull_mailbox_limit, 1000},
           {publish_mailbox_limit, 1000}]}
]}.
