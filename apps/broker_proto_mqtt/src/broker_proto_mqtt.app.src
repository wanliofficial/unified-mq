{application, broker_proto_mqtt, [
    {description, "MQTT 3.1.1 adapter: frame codec, connection FSM, message construction"},
    {vsn, "0.1.0"},
    {registered, [broker_proto_mqtt_sup, mqtt_conn_sup]},
    {mod, {broker_proto_mqtt_app, []}},
    {applications, [kernel, stdlib, sasl, ranch, broker_core, broker_metrics,
                    broker_storage, broker_router, broker_queue, broker_subscription,
                    broker_event, broker_security, broker_retain]},
    {env, [{%% Empty on purpose: a library/test node binds no port unless the
            %% release config (config/sys.config.src) supplies a listener. T12's
            %% listener suite supplies its own ephemeral port.
            listeners, []},
           {pull_page_limit, 32},
           {max_inflight, 64},
           {pull_poll_interval_ms, 1000},
           {inflight_snapshot_ms, 20},
           {max_keepalive_ms, 60000},
           %% S2-C (ADR-018 §18.4): QoS 2 is allowed by default and bounded by
           %% the backend capability at CONNECT (E2). `released' + `received'
           %% per session are capped; over the cap is a deliberate disconnect.
           {mqtt_max_qos, 2},
           {max_qos2_state_per_session, 100},
           %% S2-E (ADR-015 §15.1/§15.4): the ack-timeout failure signal and the
           %% default publish-time TTL (0 = no expiry).
           {ack_timeout_ms, 30000},
           {message_ttl_ms, 0}]}
]}.
