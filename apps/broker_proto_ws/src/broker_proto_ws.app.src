{application, broker_proto_ws, [
    {description, "WebSocket adapter: RFC 6455 framing plus the broker's own JSON/binary message API"},
    {vsn, "0.1.0"},
    {registered, [broker_proto_ws_sup]},
    {mod, {broker_proto_ws_app, []}},
    {applications, [kernel, stdlib, sasl, ranch, broker_ws, broker_core, broker_metrics,
                    broker_storage, broker_router, broker_queue, broker_subscription,
                    broker_event, broker_security]},
    {env, [{%% No listener unless the release config supplies one; CT binds its
            %% own ephemeral port, exactly like broker_proto_mqtt.
            listeners, []},
           {max_frame_bytes, 16777216},
           {max_publish_bytes, 1048576}]}
]}.
