{application, broker_cluster, [
    {description, "Metadata Raft ownership, epoch fencing and replicated commit"},
    {vsn, "0.1.0"},
    {registered, [broker_cluster_sup, broker_cluster_cache,
                  broker_cluster_meta_ctl]},
    {mod, {broker_cluster_app, []}},
    {applications, [kernel, stdlib, sasl, crypto, public_key, broker_core,
                    broker_metrics, broker_meta, ra]},
    %% Single-node defaults: the metadata group has one member, the local node
    %% is the only replica, and the queue hooks are still installed. With no
    %% partition metadata the guard is a no-op, so S1~S3 behaviour is unchanged.
    {env, [{data_dir, "data/ra"},
           {members, []},                  %% [] -> [node()]
           {quorum_timeout_ms, 5000},
           {replicate_timeout_ms, 2000},
           %% Rebalance trigger (ADR-032 D4): default closed. An operator runs
           %% `broker_rebalance:step/0' by hand; nothing auto-rebalances.
           {rebalance, #{enabled => false, hysteresis => 1, cooldown_ms => 300000}},
           %% S12-D (ADR-034 D8): default closed. Off means the routing hooks
           %% (`{broker_queue, router}', `{broker_subscription, owner}') are not
           %% installed at all, so a single node behaves byte for byte as before
           %% and a non-owner append is still refused by the fencing guard.
           %% Turning it on requires a replica set that covers every possible
           %% owner plus `replicated_commit' (ADR-034 D7), otherwise assign /
           %% migrate are refused before they reach the log.
           {cross_node_delivery, false},
           %% One hop budget for a forwarded call; the caller's protocol
           %% adapter already has its own timeout, so this only bounds the rpc.
           {cross_node_timeout_ms, 2000},
           %% ADR-035: cross-node / replication-channel TLS. Shipped OFF, so
           %% distribution is still plain `inet_tcp' + cookie and nothing about
           %% a single-node or existing cluster changes. Turning it on also
           %% requires `-proto_dist inet_tls -ssl_dist_optfile <File>' in
           %% vm.args -- this block is the *declaration*, and boot refuses a
           %% declaration that disagrees with what the node actually booted
           %% with (see broker_cluster_dist_tls:validate/0).
           {dist_tls, #{enabled => false}}]}
]}.
