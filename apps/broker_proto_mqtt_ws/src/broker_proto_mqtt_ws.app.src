{application, broker_proto_mqtt_ws, [
    {description, "MQTT over WebSocket: RFC 6455 transport for the MQTT engine"},
    {vsn, "0.1.0"},
    {registered, [broker_proto_mqtt_ws_sup]},
    {mod, {broker_proto_mqtt_ws_app, []}},
    {applications, [kernel, stdlib, sasl, ranch, broker_ws, broker_proto_mqtt,
                    broker_core, broker_metrics, broker_storage, broker_router,
                    broker_queue, broker_subscription, broker_event,
                    broker_security, broker_retain]},
    {env, [{%% No listener unless the release config supplies one; CT binds its
            %% own ephemeral port, exactly like broker_proto_ws.
            listeners, []},
           %% MQTT 3.1.1 §6 and MQTT 5.0 §6 both name the `mqtt' subprotocol;
           %% the two older spellings are accepted because clients in the wild
           %% still send them. Server preference order is this list's order.
           {subprotocols, [<<"mqtt">>, <<"mqttv3.1">>, <<"mqttv3.1.1">>]},
           %% One WebSocket frame may carry any number of MQTT packets, so this
           %% bounds a frame, not a packet (`mqtt_max_packet_size' remains the
           %% packet-level cap).
           {max_frame_bytes, 16777216}]}
]}.
