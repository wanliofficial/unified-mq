{application, broker_subscription, [
    {description, "Subscriptions, per-subscription cursors, delivery and session persistence"},
    {vsn, "0.1.0"},
    {registered, [broker_subscription_sup, broker_subscription_worker]},
    {mod, {broker_subscription_app, []}},
    {applications, [kernel, stdlib, sasl, broker_core, broker_metrics, broker_storage,
                    broker_router, broker_queue]},
    {env, [{data_dir, "data"},
           {cursor_max_regress, 64},
           {cursor_flush_interval_ms, 100},
           {inflight_flush_interval_ms, 100},
           %% ADR-019 §19.1: the per-{SubRef, Partition} bound on
           %% `acked ∪ assigned'. A full window refuses further claims instead of
           %% evicting a live assignment.
           {shared_state_max, 4096},
           %% S2-E (ADR-015 §15.2/§15.3): retry backoff, attempt budget and the
           %% dead-letter destination template.
           {retry_tick_ms, 1000},
           {retry_base_ms, 1000},
           {retry_max_delay_ms, 60000},
           {max_attempts, 10},
           {dlq_name_pattern, <<"$dlq/{tenant}/{original}">>}]}
]}.
