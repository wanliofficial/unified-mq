{application, broker_storage, [
    {description, "Storage behavior plus memory and WAL backends"},
    {vsn, "0.1.0"},
    {registered, []},
    {mod, {broker_storage_app, []}},
    {applications, [kernel, stdlib, sasl, broker_core, broker_metrics]},
    {env, [{retention, #{max_bytes => 0,
                         max_age_ms => 0,
                         check_interval_ms => 60000}}]}
]}.
