export PATH="/home/wanli/Development/otp-28.3.1/bin:$PATH"
export REBAR_CACHE_DIR="${REBAR_CACHE_DIR:-$HOME/.cache/rebar3}"

# Verify OTP major version before building: the project targets OTP 28.
erl -noshell -eval 'case erlang:system_info(otp_release) of
  "28" -> halt(0);
  R -> io:format(standard_error, "wrong OTP: ~s (need 28)~n", [R]), halt(1)
end.'