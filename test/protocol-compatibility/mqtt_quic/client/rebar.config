%% Third-party MQTT client for the MQTT-over-QUIC compatibility run.
%%
%% `emqtt' (EMQX's official Erlang client) is the client under test: its
%% `emqtt_quic' module speaks MQTT over QUIC through `quicer', with ALPN `mqtt'
%% and one client-initiated bidi stream -- i.e. exactly the OASIS CN Draft 3
%% shape this broker implements. Nothing in this project is on the client side.
%%
%% Two deliberate choices:
%%
%%   * `emqtt' publishes 1.16.1 with a hex dependency on `quicer' 0.2.15, while
%%     this repository builds 0.4.12. The override below replaces emqtt's dep
%%     list with the version pinned here, so one msquic build serves both sides
%%     and the harness cannot drift from the broker's own NIF version.
%%   * the replaced dep list is empty on purpose: only the QUIC transport is
%%     exercised, and `gun'/`cowlib'/`getopt' exist for emqtt's TCP and
%%     WebSocket transports. The driver calls `emqtt:start_link/1' directly and
%%     never starts the `emqtt' application, whose `.app' would demand `gun'.
%%
%% `base_dir' points outside this directory, and that is load-bearing rather
%% than tidiness: `rebar3 ct' copies the whole top-level `test/' tree into
%% `_build/*/extras' and compiles every `.erl' it finds there. A `_build' of the
%% client inside this repo would drag vendored `quicer' sources (which only
%% compile inside their own project context) into every CT run of the project
%% and abort it. Keeping the client's build tree under the repo-level `_build/'
%% keeps `test/' source-only.
{base_dir, "../../../../_build/quic_client"}.

{erl_opts, [debug_info]}.

{deps,
 [{emqtt, "1.16.1"},
  {quicer, "0.4.12"}]}.

{overrides,
 [{override, emqtt, [{deps, []}]}]}.
