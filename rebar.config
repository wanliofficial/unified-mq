%% Root umbrella project for UnifiedMQ.
%%
%% Spikes under spikes/ are intentionally NOT part of this umbrella:
%% each spike is a standalone rebar3 project so it can be thrown away
%% independently (see docs/roadmap.md section 2).
{erl_opts, [
    debug_info,
    warn_unused_vars,
    warn_shadow_vars,
    warn_unused_import,
    warnings_as_errors
]}.

%% ranch is the TCP acceptor layer behind the MQTT listener (T12). Pinned to the
%% 2.x line, whose `ranch_protocol:start_link/3' + `{handshake, Ref, ...}'
%% message is the contract `mqtt_listener' implements. 1.x returns a bare pid
%% from a different callback and has no `ranch_embedded_sup', which is how the
%% listener lives under *our* supervisor instead of ranch's global one.
{deps, [{ranch, "2.3.0"},
        %% ADR-003 froze rabbitmq/ra 3.2.0 as the consensus library. The four
        %% apps are vendored under vendor/ (S0.1 verified this exact version on
        %% OTP 28.3.1) and exposed through _checkouts/, so builds do not need
        %% network access.
        {ra, "3.2.0"}]}.

{dialyzer, [
    {warnings, [unknown]},
    {plt_apps, top_level_deps},
    %% `broker_security_tls' calls `ssl', whose specs reference `public_key'
    %% types; without it in the PLT dialyzer reports OTP's own types as unknown.
    {plt_extra_apps, [public_key]}
]}.

%% apps/ is auto-detected by rebar3 as an umbrella lib dir; boot order comes
%% from each app's `applications' list, not from a single master tree.
%% Measured on rebar3 3.27 / OTP 28.3.1: {sys_config_src, ...} and
%% {vm_args_src, ...} put the files under releases/Vsn/ still named *.src, where
%% the generated launcher does not look, and the node then fails to start.
%% {sys_config, ...} / {vm_args, ...} copy them into the place the launcher reads.
{relx, [
    {release, {unified_mq, "0.1.0"}, [
        sasl,
        ranch,
        broker_core,
        broker_metrics,
        broker_storage,
        broker_router,
        broker_queue,
        broker_subscription,
        broker_event,
        broker_security,
        broker_retain,
        broker_proto_mqtt,
        broker_ws,
        broker_proto_mqtt_ws,
        broker_proto_mqtt_sn,
        %% S8-D: the app itself has no `quicer' dependency (`optional_applications'
        %% + `listeners => []'), so a QUIC-less release still ships and starts it;
        %% only the NIF is missing, and a hand-configured listener refuses with
        %% `{error, quicer_not_available}'. Leaving it out of the list would make
        %% the default release behave differently from a hand-built one.
        broker_proto_mqtt_quic,
        broker_meta,
        broker_cluster,
        broker_proto_ws,
        broker_proto_nats,
        broker_proto_amqp,
        broker_proto_kafka,
        broker_proto_pulsar,
        broker_proto_agent_rpc,
        broker_proto_a2a,
        broker_proto_mcp,
        broker_proto_acp,
        %% S10-A: signaling front end. Ships in every release but starts with
        %% `listeners => []', so the port stays closed until configured
        %% (ADR-028, R-T5).
        broker_proto_webrtc,
        broker_admin
    ]},
    {dev_mode, true},
    {include_erts, false},
    {sys_config, "./config/sys.config.src"},
    {vm_args, "./config/vm.args.src"}
]}.

{shell, [
    {apps, [broker_proto_mqtt, broker_proto_ws, broker_proto_nats, broker_proto_amqp]},
    {config, "config/sys.config.src"}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all,
                    %% T15's capture analyzer lives under test/ and includes the
                    %% production frame records, like the broker_proto_mqtt suite.
                    {i, "apps/broker_proto_mqtt/include"}]},
        {deps, [{proper, "1.5.0"}]}
    ]},
    %% T14's crash-recovery release (design §8.1). `dev_mode = false` copies the
    %% apps into `rel/unified_mq/lib/` instead of symlinking back into this
    %% checkout, which is what makes the tree mountable into a container: the
    %% default profile's `lib/` entries and `releases/*/sys.config` are absolute
    %% host symlinks. ERTS is deliberately not bundled: the image supplies it
    %% (OTP 28), so the release does not carry a glibc-versioned beam runtime.
    {t14, [
        {relx, [
            {dev_mode, false},
            {include_erts, false}
        ]}
    ]},
    %% S8-D's real-quic path: the profile that pulls in `quicer'. Every other
    %% command (`rebar3 compile' / `ct' / `eunit' / `release') stays in the
    %% default profile, where QUIC is an *optional* application whose listener
    %% refuses to start -- the default build is a complete, QUIC-less broker and
    %% the NIF is never fetched or linked.
    %%
    %% The `relx' block is copied in full rather than inherited: a profile's
    %% `relx' replaces the top-level one, so dropping the app list here would
    %% produce a QUIC-enabled release that contains none of the other protocols.
    {quic, [
        {deps, [{quicer, "0.4.12"}]},
        {relx, [
            {release, {unified_mq, "0.1.0"}, [
                sasl,
                ranch,
                broker_core,
                broker_metrics,
                broker_storage,
                broker_router,
                broker_queue,
                broker_subscription,
                broker_event,
                broker_security,
                broker_retain,
                broker_proto_mqtt,
                broker_ws,
                broker_proto_mqtt_ws,
                broker_proto_mqtt_sn,
                broker_proto_mqtt_quic,
                broker_meta,
                broker_cluster,
                broker_proto_ws,
                broker_proto_nats,
                broker_proto_amqp,
                broker_proto_kafka,
                broker_proto_pulsar,
                broker_proto_agent_rpc,
                broker_proto_a2a,
                broker_proto_mcp,
                broker_proto_acp,
                broker_proto_webrtc,
                broker_admin,
                quicer
            ]},
            {dev_mode, true},
            {include_erts, false},
            {sys_config, "./config/sys.config.src"},
            {vm_args, "./config/vm.args.src"}
        ]}
    ]}
]}.
