%% S10-0 spike: WSS signaling front end, built from what the repo already has.
%%
%% Standalone project - NOT part of the umbrella (same rule as spikes/s0_*).
%% `broker_ws' is an in-repo pure library with no hex package, so it comes in
%% through `_checkouts/'. That reference is a symlink to the real source: the
%% spike compiles *the same modules* the broker ships, no copy, no fork.
%%
%% Run:  ./run_spike.sh   (ws, plain TCP)
%%       ./run_wss.sh     (wss, ranch ssl transport)
{erl_opts, [debug_info, warn_unused_vars, warnings_as_errors]}.

{deps, [{ranch, "2.3.0"},
        %% the in-repo pure WebSocket library; a path dep keeps the spike
        %% compiling the same source the broker ships (no copy, no fork)
        {broker_ws, {path, "../../apps/broker_ws"}}]}.

{profiles, [
    {test, [{erl_opts, [debug_info]}]}
]}.
