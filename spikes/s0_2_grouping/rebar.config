%% S0.2 spike: Raft grouping model (README 5.3 / 6.2, ADR-008)
%%
%% Measures the resource cost of running many independent Raft groups on one
%% node, to decide how many partitions should share one Raft group. This is a
%% single-node experiment: each "group" is a 1-voter ra server on the local
%% node. That isolates the per-group machinery overhead (processes, ETS, WAL,
%% election timers) from network/replication cost, which S0.1 already pinned
%% at ~677 us/write on a 3-node cluster. The decision is then: given a per-group
%% cost here and a per-write cost from S0.1, pick a group size that bounds both
%% fault domain (README 5.3) and overhead.
%%
%%   export PATH=/home/wanli/Development/otp-28.3.1/bin:$PATH
{erl_opts, [debug_info, warn_unused_vars, warnings_as_errors]}.

{deps, [
    {ra, {git, "https://github.com/rabbitmq/ra.git",
          {ref, "2d81d2126c03aaba50d5b6ac850853e2a77ba3c8"}}}
]}.

{profiles, [{test, [{erl_opts, [debug_info]}]}]}.
