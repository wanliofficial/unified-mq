%% S0.1 spike: rabbitmq/ra evaluation (README 6.2 / ADR-003)
%%
%% OTP VERSION: ra 3.2.0's docs/CI only mention OTP 26/27, but it COMPILES AND
%% RUNS cleanly on OTP 28.3.1 (verified: 3-node cluster forms, survives leader
%% kill with continuous log index, and correctly REJECTS writes when the
%% majority is lost). The project therefore uses a single OTP 28.3.1 across all
%% spikes and the future application. See REPORT.md section 5.
%%
%%   export PATH=/home/wanli/Development/otp-28.3.1/bin:$PATH
{erl_opts, [debug_info, warn_unused_vars, warnings_as_errors]}.

{deps, [
    {ra, {git, "https://github.com/rabbitmq/ra.git", {branch, "main"}}}
]}.

{profiles, [{test, [{erl_opts, [debug_info]}]}]}.
