%% Application environment, read with application:get_env/3 (design §2: S1 has
%% no broker_config app). Under OTP 28 get_env/2 returns {ok, Val} rather than
%% Val -- see design §13 J3 -- so every read site in this project uses the
%% 3-arity form. Copied into the release as releases/Vsn/sys.config by relx, and
%% read directly by `rebar3 shell'. Contains no {{...}} placeholders, so the
%% same file serves both paths.
[
  %% T12's dev environment: progress/error reports go to both the console and a
  %% file under log/ (design §13 H5 deferred file logging to T12). The path is
  %% relative to the node's CWD — the repo root for `rebar3 shell', the release
  %% root for bin/unified_mq — and logger_std_h creates the directory. This is a
  %% dev convenience only; S1's tests and Gate evidence still come from stdout.
  {kernel, [
    {logger, [
      {handler, s1_file, logger_std_h,
       #{config => #{file => "log/s1.log"},
         formatter => {logger_formatter, #{single_line => true,
                                           legacy_header => false}}}}
    ]}
  ]},

  {broker_metrics, [
    %% ADR-016: no external dependency, no process on the hot path. `enabled'
    %% false still answers every write with ok and snapshot/0 with zeros, so a
    %% deployment can turn metrics off without changing behaviour.
    {enabled, true},
    %% One summary line every 60 s. 0 removes the reporter child entirely;
    %% anything else that is not a positive integer refuses to boot.
    {report_interval_ms, 60000}
  ]},

  {broker_storage, [
    {backend, broker_storage_wal},
    %% Absolute and OUTSIDE the release tree (J8): relx's launcher `cd`s to the
    %% release root, so a relative `data_dir` would live in `_build/.../rel`
    %% and be wiped by the next `rebar3 release`; the out-of-band
    %% `create_partition/1` run would then create partitions somewhere the node
    %% never looks. `/home` is ext4 on this dev host (J11).
    {data_dir, "/home/wanli/workspace/unified-mq/data"},
    %% S0.3 §2.2: batch=32 is the throughput inflection point (17x over
    %% single-message fsync); 256 caps the latency cost of waiting for a batch.
    %% A map, not a proplist: broker_queue:storage_config/0 hands this value
    %% straight to the backend, and wal_writer/wal_group_committer read it with
    %% maps:get -- a proplist here would raise badarg on the first append.
    {wal, #{batch_size => 32,
            max_batch_size => 256,
            batch_delay_ms => #{os_buffer => 0, fsync => 1},
            index_anchor_interval => 256,
            segment_max_records => 100000}}
  ]},

  {broker_router, [
    {backend, broker_router_hash},
    %% S1 fixes the partition count; elastic partitioning is S4 (ADR-008).
    {partitions, 4}
  ]},

  {broker_queue, [
    {partitions, 4}
  ]},

  {broker_subscription, [
    %% Its own key, not broker_storage's: layers read their own config even
    %% when the values coincide (design §13 K4). Must be the same absolute path
    %% as broker_storage's `data_dir' (J8), or `.subs'/`.cursors' land somewhere
    %% the node's storage side never sees.
    {data_dir, "/home/wanli/workspace/unified-mq/data"},
    %% Bounded cursor regress window (Gate S1 R3). Setting both to 1/0 selects
    %% the near-zero-regress tier, which pays a per-ack fsync.
    {cursor_max_regress, 64},
    {cursor_flush_interval_ms, 100},
    {inflight_flush_interval_ms, 100}
  ]},

  {broker_security, [
    {users, [
      {<<"guest">>, #{password => <<"guest">>, tenant_id => <<"t0">>}}
    ]},
    {acl, allow}
  ]},

  {broker_event, [
    %% S1 implements the two arms that need no parsing (pass_through /
    %% disabled). validate_if_present / required / normalize are accepted by
    %% the type but rejected at the call site -- failing loudly beats shipping
    %% unvalidated events behind a validated-looking config (design §11.2
    %% OQ-5, ADR-004).
    {policy, pass_through}
  ]},

  {broker_proto_mqtt, [
    %% One listener per map (T12, design §6 boot step 4). The listener is what
    %% makes the MQTT port exist at all; `rebar3 shell` and the release both read
    %% this file, and CT supplies its own ephemeral listener instead.
    {listeners, [
      #{port => 1883,
        num_acceptors => 10,
        max_connections => 1024,
        %% Must be 0 whenever broker_storage:backend is broker_storage_memory
        %% (design §3.3 E12), so QoS 1/2 are refused at SUBACK instead of
        %% failing at append time. Everything in this map travels to the
        %% connection as `ProtoOpts' (the L20 seam); the app-level keys below
        %% are the defaults for connections started outside a listener.
        mqtt_max_qos => 2,
        max_keepalive_ms => 60000}
    ]},
    {pull_page_limit, 32},
    {max_inflight, 64},
    {pull_poll_interval_ms, 1000},
    {inflight_snapshot_ms, 20},
    {mqtt_max_qos, 2},
    {max_keepalive_ms, 60000},
    %% ADR-018 §18.4: per-session cap on `released' + `received'. Over the cap
    %% the connection is closed (a silent drop of QoS 2 state would lie).
    {max_qos2_state_per_session, 100}
  ]},

  {broker_retain, [
    %% J8: same absolute path as broker_storage/broker_subscription -- the
    %% retained snapshot must live beside the sessions it serves.
    {data_dir, "/home/wanli/workspace/unified-mq/data"},
    {retain_flush_interval_ms, 100},
    {max_retained, 10000},
    {max_retained_bytes, 67108864},
    {max_payload_bytes, 262144}
  ]}
].
