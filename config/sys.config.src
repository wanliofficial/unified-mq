%% Application environment, read with application:get_env/3 (design §2: S1 has
%% no broker_config app). Under OTP 28 get_env/2 returns {ok, Val} rather than
%% Val -- see design §13 J3 -- so every read site in this project uses the
%% 3-arity form. Copied into the release as releases/Vsn/sys.config by relx, and
%% read directly by `rebar3 shell'. Contains no {{...}} placeholders, so the
%% same file serves both paths.
[
  %% T12's dev environment: progress/error reports go to both the console and a
  %% file under log/ (design §13 H5 deferred file logging to T12). The path is
  %% relative to the node's CWD — the repo root for `rebar3 shell', the release
  %% root for bin/unified_mq — and logger_std_h creates the directory. This is a
  %% dev convenience only; S1's tests and Gate evidence still come from stdout.
  {kernel, [
    {logger, [
      {handler, s1_file, logger_std_h,
       #{config => #{file => "log/s1.log"},
         formatter => {logger_formatter, #{single_line => true,
                                           legacy_header => false}}}}
    ]}
  ]},

  {broker_metrics, [
    %% ADR-016: no external dependency, no process on the hot path. `enabled'
    %% false still answers every write with ok and snapshot/0 with zeros, so a
    %% deployment can turn metrics off without changing behaviour.
    {enabled, true},
    %% One summary line every 60 s. 0 removes the reporter child entirely;
    %% anything else that is not a positive integer refuses to boot.
    {report_interval_ms, 60000}
  ]},

  {broker_storage, [
    {backend, broker_storage_wal},
    %% Absolute and OUTSIDE the release tree (J8): relx's launcher `cd`s to the
    %% release root, so a relative `data_dir` would live in `_build/.../rel`
    %% and be wiped by the next `rebar3 release`; the out-of-band
    %% `create_partition/1` run would then create partitions somewhere the node
    %% never looks. `/home` is ext4 on this dev host (J11).
    {data_dir, "/home/wanli/workspace/unified-mq/data"},
    %% S0.3 §2.2: batch=32 is the throughput inflection point (17x over
    %% single-message fsync); 256 caps the latency cost of waiting for a batch.
    %% A map, not a proplist: broker_queue:storage_config/0 hands this value
    %% straight to the backend, and wal_writer/wal_group_committer read it with
    %% maps:get -- a proplist here would raise badarg on the first append.
    {wal, #{batch_size => 32,
            max_batch_size => 256,
            batch_delay_ms => #{os_buffer => 0, fsync => 1},
            index_anchor_interval => 256,
            segment_max_records => 100000,
            %% S2-G / design §4.7: when this many appends are already waiting in
            %% the writer's batch queue, a new append is refused with
            %% `{error, {overloaded, PartitionId}}` instead of growing the queue.
            %% 0 disables the bound (the S1 shape). The default is a pre-benchmark
            %% estimate; S2-I will tune it from measurements.
            max_pending_appends => 4096}},
    %% S2-F / ADR-014 §14.2: whole-segment retention. `max_bytes' and
    %% `max_age_ms' are independent limits; when both are set a segment is
    %% deleted only if BOTH agree (the stricter reading). 0 means "no limit".
    %% Deletion can never cross `committed' (min live cursor - 1), so a slow
    %% consumer pins the disk instead of losing data.
    {retention, #{max_bytes => 0,
                  max_age_ms => 0,
                  check_interval_ms => 60000}}
  ]},

  {broker_router, [
    {backend, broker_router_hash},
    %% S1 fixes the partition count; elastic partitioning is S4 (ADR-008).
    {partitions, 4}
  ]},

  {broker_queue, [
    {partitions, 4}
  ]},

  {broker_subscription, [
    %% Its own key, not broker_storage's: layers read their own config even
    %% when the values coincide (design §13 K4). Must be the same absolute path
    %% as broker_storage's `data_dir' (J8), or `.subs'/`.cursors' land somewhere
    %% the node's storage side never sees.
    {data_dir, "/home/wanli/workspace/unified-mq/data"},
    %% Bounded cursor regress window (Gate S1 R3). Setting both to 1/0 selects
    %% the near-zero-regress tier, which pays a per-ack fsync.
    {cursor_max_regress, 64},
    {cursor_flush_interval_ms, 100},
    {inflight_flush_interval_ms, 100},
    %% ADR-019 §19.1: per-{SubRef, Partition} bound on `acked ∪ assigned'.
    %% A full window refuses more claims (counted, bounded) rather than
    %% evicting an assignment somebody is still holding.
    {shared_state_max, 4096},
    %% S2-E (ADR-015): retry and dead-letter policy. `attempts' counts failed
    %% deliveries; reaching `max_attempts' dead-letters the message and advances
    %% the cursor, so a poison message cannot pin a partition.
    {retry_tick_ms, 1000},
    {retry_base_ms, 1000},
    {retry_max_delay_ms, 60000},
    {max_attempts, 10},
    %% Variables: {tenant} {original} {qos} {kind}. A `+'/'#' or an unknown
    %% variable fails the application at boot (a typo must not wait for the
    %% first dead letter to surface).
    {dlq_name_pattern, <<"$dlq/{tenant}/{original}">>}
  ]},

  {broker_security, [
    %% S7: the identity table every protocol authenticates against -- MQTT,
    %% WebSocket, NATS, AMQP, Kafka and Pulsar all resolve their credential
    %% here.  A record may carry `password' (the user/password shape) and/or
    %% `token' (the bearer shape Pulsar's `token' auth method uses).
    {users, [
      {<<"guest">>, #{password => <<"guest">>, tenant_id => <<"t0">>}}
    ]},
    %% S7: the tenant an anonymous connection runs as.  A client never picks
    %% its own tenant -- the tenant comes from the matched user record, and
    %% this is the fallback when there is no record.
    {default_tenant, <<"t0">>},
    %% S7: which protocols must present a credential.  Empty means every
    %% protocol accepts an anonymous connection (the posture before S7).  List
    %% a protocol to make its handshake the only way in, e.g. [<<"ws">>].
    %% A protocol whose handshake cannot carry a credential is never required.
    {require_auth, []},
    %% S6 ACL: `allow' keeps the pre-S6 allow-all posture. Replace with an
    %% ordered first-match rule list to enforce policy:
    %%   [{#{effect => deny,  principal => <<"*">>, action => <<"*">>,
    %%       pattern => <<"$sys/*">>},
    %%    #{effect => allow, principal => <<"*">>, action => publish,
    %%       pattern => <<"t0/*">>}}]
    %% A principal can never widen its tenant: tenant isolation is checked
    %% before any rule.
    {acl, allow},
    %% S6 resource limits (README §10.1). Missing keys use the defaults below.
    {limits, #{max_message_bytes => 1048576,
               max_header_count => 32,
               max_header_value_bytes => 8192,
               max_event_attributes => 64,
               max_extension_value_bytes => 4096,
               max_json_depth => 16}},
    %% S6 TLS: disabled by default so an existing plaintext deployment keeps
    %% working. Enable it and point at PEM files to terminate TLS; rotate by
    %% replacing the files and POSTing /api/v1/tls/reload.
    {tls, #{enabled => false,
            certfile => undefined,
            keyfile => undefined,
            cacertfile => undefined,
            verify => verify_none,
            fail_if_no_peer_cert => false,
            versions => ['tlsv1.2', 'tlsv1.3']}}
  ]},

  {broker_admin, [
    %% S6 management API. Loopback by default: the API can create backups and
    %% reload TLS, so binding it wide has to be a deliberate change.
    {enabled, true},
    {bind, {127, 0, 0, 1}},
    {port, 8090},
    %% Empty token = no authentication. Set it whenever `bind' is not loopback.
    {token, <<>>},
    %% Absolute path outside the release tree, same discipline as data_dir.
    {backup_dir, "/home/wanli/workspace/unified-mq/backups"}
  ]},

  {broker_event, [
    %% ADR-020: the default remains the S1/S2 identity -- enabling CloudEvents
    %% is a per-tenant + destination decision, never a global surprise.
    {policy, pass_through},
    %% Ordered first-match list: {Tenant, Destination, Policy}. `<<"*">>' is
    %% the wildcard; Destination accepts MQTT `+` / `#'.
    {policies, []},
    %% Opt-in dedup windows: {Tenant, Destination, WindowMs}, key source+id.
    {dedup, []},
    {dedup_max_entries, 100000},
    %% Opt-in isolation copies for rejected events:
    %% {Tenant, Destination, <<"$invalid/{tenant}/{destination}">>}.
    {quarantine, []},
    %% README §10.2 / W3C Trace Context. `off' (default) strips client-supplied
    %% `traceparent'/'tracestate'; `on' validates and propagates them for every
    %% tenant; `{trusted_tenants, [<<"t1">>]}' limits propagation to the listed
    %% tenants. Trace headers never affect identity, tenant or ACL decisions.
    {trace_context, off}
  ]},

  {broker_proto_mqtt, [
    %% One listener per map (T12, design §6 boot step 4). The listener is what
    %% makes the MQTT port exist at all; `rebar3 shell` and the release both read
    %% this file, and CT supplies its own ephemeral listener instead.
    {listeners, [
      #{port => 1883,
        num_acceptors => 10,
        max_connections => 1024,
        %% Must be 0 whenever broker_storage:backend is broker_storage_memory
        %% (design §3.3 E12), so QoS 1/2 are refused at SUBACK instead of
        %% failing at append time. Everything in this map travels to the
        %% connection as `ProtoOpts' (the L20 seam); the app-level keys below
        %% are the defaults for connections started outside a listener.
        mqtt_max_qos => 2,
        max_keepalive_ms => 60000}
    ]},
    {pull_page_limit, 32},
    {max_inflight, 64},
    {pull_poll_interval_ms, 1000},
    {inflight_snapshot_ms, 20},
    {mqtt_max_qos, 2},
    {max_keepalive_ms, 60000},
    %% ADR-018 §18.4: per-session cap on `released' + `received'. Over the cap
    %% the connection is closed (a silent drop of QoS 2 state would lie).
    {max_qos2_state_per_session, 100},
    %% S2-E (ADR-015 §15.1): how long a delivery may stay unacknowledged before
    %% the connection reports a failure. It must exceed a normal ack latency
    %% (the risk in the execution plan §7). 0 disables the detector.
    {ack_timeout_ms, 30000},
    %% S2-E (ADR-015 §15.4): default per-message TTL stamped into `expires_at'
    %% at publish time. 0/undefined means no expiry (S1 semantics).
    {message_ttl_ms, 0},
    %% S2.5 (ADR-017 §17.3): inbound packet cap in bytes; 0 disables it.
    {mqtt_max_packet_size, 0}
  ]},

  {broker_proto_ws, [
    %% Same posture as broker_proto_mqtt: a map per listener makes the port
    %% exist; CT supplies its own ephemeral listener. The application keys
    %% below are the defaults for connections started outside a listener.
    {listeners, [
      #{port => 8080,
        ref => {ws, 8080},
        num_acceptors => 10,
        max_connections => 1024}
    ]},
    %% S5 WebSocket v1: QoS 0/1 only (v1 has no QoS 2 handshake). Over the cap
    %% the publish is refused with `payload_too_large'.
    {max_publish_bytes, 1048576},
    {max_frame_bytes, 16777216}
  ]},

  {broker_proto_mqtt_ws, [
    %% S8-B: MQTT over WebSocket. A separate app and port from the broker's own
    %% ws API above (8080) -- the two speak entirely different protocols, and
    %% keeping them apart is what lets this one change without touching S5's
    %% pinned wire behaviour. Any URL path is accepted; the subprotocol decides
    %% whether the peer is an MQTT client. TLS follows `broker_security.tls'
    %% (wss), exactly like every other listener.
    {listeners, [
      #{port => 8083,
        ref => {mqtt_ws, 8083},
        num_acceptors => 10,
        max_connections => 1024}
    ]},
    %% MQTT 3.1.1 §6 / MQTT 5.0 §6 name `mqtt'; the older spellings are still
    %% sent by clients in the field. Order is the server's preference.
    {subprotocols, [<<"mqtt">>, <<"mqttv3.1">>, <<"mqttv3.1.1">>]},
    {max_frame_bytes, 16777216}
  ]},

  {broker_proto_mqtt_sn, [
    %% S8-C: MQTT-SN 1.2 over UDP. 1884 is the conventional neighbour of MQTT's
    %% 1883; CT binds port 0 and asks the kernel. One socket serves the whole
    %% gateway -- sessions are told apart by {IP, Port}, then by client id.
    {listeners, [#{port => 1884}]},
    %% `#{1 => <<"t0/sensor/temp">>}': gateway-wide, readable by every client
    %% without a REGISTER. Ids 0, 0xFFFE and 0xFFFF are reserved and fail boot.
    {predefined_topics, #{}},
    {gateway_id, 1},
    %% 0 = never broadcast ADVERTISE on our own; SEARCHGW is always answered.
    %% The address is broadcast by default; a single-host deployment points it
    %% at 127.0.0.1.
    {advertise_interval_ms, 0},
    {advertise_address, {255, 255, 255, 255}},
    %% Clients listen on the MQTT-SN well-known port (1884), which is not
    %% necessarily this listener's own port.
    {advertise_port, 1884},
    %% Sleeping clients are detached sessions, not buffers: the cap bounds how
    %% many sessions the gateway keeps alive with nothing on the wire.
    {max_asleep_clients, 1024},
    {max_topic_ids_per_client, 1024},
    %% Unacked downlink PUBLISHes per session (MQTT's in-flight window).
    {max_inflight, 20},
    %% 1.5x/2x of a client's requested keepalive duration, capped here.
    {max_duration_s, 3600}
  ]},

  {broker_proto_kafka, [
    %% S5 Kafka adapter. 9092 is the standard port; 9093 avoids a local
    %% Kafka. CT binds its own ephemeral port.
    {listeners, [
      #{port => 9093,
        ref => {kafka, 9093},
        num_acceptors => 10,
        max_connections => 1024}
    ]}
  ]},

  {broker_proto_amqp, [
    %% S5 AMQP 0-9-1 adapter. 5672 is the standard port; 5673 avoids a local
    %% RabbitMQ. CT binds its own ephemeral port.
    {listeners, [
      #{port => 5673,
        ref => {amqp, 5673},
        num_acceptors => 10,
        max_connections => 1024}
    ]},
    {poll_ms, 100}
  ]},

  {broker_proto_pulsar, [
    %% S5 Pulsar adapter. 6650 is the standard binary port; CT binds its own
    %% ephemeral port. `advertised_host' is what LOOKUP returns so the client
    %% opens its producer/consumer connection back to this node.
    {listeners, [
      #{port => 6650,
        ref => {pulsar, 6650},
        num_acceptors => 10,
        max_connections => 1024}
    ]},
    {advertised_host, <<"127.0.0.1">>}
  ]},

  {broker_proto_nats, [
    %% S5 NATS core adapter. 4222 is frequently taken by a local nats-server;
    %% the release default therefore uses 4223. CT binds its own ephemeral
    %% port. `auth_token' is unset here: set it to require CONNECT auth.
    {listeners, [
      #{port => 4223,
        ref => {nats, 4223},
        num_acceptors => 10,
        max_connections => 1024}
    ]},
    {max_payload, 1048576},
    {shared_poll_ms, 100}
  ]},

  {broker_meta, [
    %% S4 control plane: Mnesia appends `Mnesia.<node>' below this directory.
    %% Absolute and OUTSIDE the release tree (J8), in its own subdirectory so
    %% the schema files sit beside -- not among -- the WAL segments.
    {data_dir, "/home/wanli/workspace/unified-mq/data/mnesia"}
  ]},

  {broker_cluster, [
    %% S4 metadata Raft (ra). ra appends `<node>' below this directory. It MUST
    %% be absolute and outside the release tree: the built-in default
    %% "data/ra" is relative to the node CWD (the release root), so a release
    %% mounted read-only would abort boot with "Ra could not create its data
    %% directory". Same J8 discipline as broker_storage's data_dir.
    {data_dir, "/home/wanli/workspace/unified-mq/data/ra"}
  ]},

  {broker_retain, [
    %% J8: same absolute path as broker_storage/broker_subscription -- the
    %% retained snapshot must live beside the sessions it serves.
    {data_dir, "/home/wanli/workspace/unified-mq/data"},
    {retain_flush_interval_ms, 100},
    {max_retained, 10000},
    {max_retained_bytes, 67108864},
    {max_payload_bytes, 262144}
  ]}
].
